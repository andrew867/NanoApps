# Headless preview of the launcher: renders every screen to PNG with no device
# and no framebuffer. Worth using - every layout bug in this app was found in a
# picture and was invisible in the source.
#
# LVGL is compiled from the vendored source into this app's own build directory,
# so a fresh clone builds. Point LVLIB at a prebuilt library to skip that.

# ccache if it is installed, nothing if it is not. LVGL is four hundred
# odd translation units and most rebuilds recompile all of them
# identically.
# Stated rather than inherited from whichever rule happens to come first:
# adding the cache-directory rule above `shots` silently made THAT the default,
# and a bare make started reporting an empty directory as up to date.
.DEFAULT_GOAL := shots

CCACHE := $(shell command -v ccache 2>/dev/null)

CC     ?= $(CCACHE) cc
AR     ?= ar
BUILD  := build
LVGL   ?= ../../../lvgl
LV_CONF := lv_conf_host.h

# LVGL objects live on the native filesystem, not the Windows drive.
#
# A full pass measured twelve minutes wall for four and a half of CPU. The rest
# was drvfs: four hundred and sixty-six object files written across the mount.
# The kernel build keeps its output under /home for exactly this reason.
#
# The directory is named after the hash of the config that produced the
# objects, so switching branch - which rewrites lv_conf and moves its mtime
# without changing a byte - reuses what is already there instead of rebuilding
# it, and flipping a config option back finds its old objects still present.
LV_CONF_ID := $(shell md5sum $(LV_CONF) 2>/dev/null | cut -c1-12)
LV_CACHE   ?= $(HOME)/.cache/n31-lvgl/launcher-host-$(LV_CONF_ID)

$(LV_CACHE):
	@mkdir -p $@

LVLIB_OWN  = $(LV_CACHE)/liblvgl_host.a
LVLIB     ?= $(LVLIB_OWN)

LV_CFLAGS := -DLV_CONF_INCLUDE_SIMPLE -DLV_CONF_PATH=\"$(CURDIR)/lv_conf_host.h\" \
             -I$(LVGL) -I$(LVGL)/src -I$(LVGL)/include -I$(LVGL)/.. -I..

CFLAGS := -O1 -g -std=gnu99 -Wall -Wextra -Wno-unused-parameter
SRCS := preview.c ../ui.c ../apps.c ../status.c ../../build_stamp.c

# ---- build stamp -----------------------------------------------------------
BUILD_STAMP := $(shell date -u +%Y%m%d.%H%M)
BUILD_GIT   := $(shell git rev-parse --short=7 HEAD 2>/dev/null || echo nogit)
CFLAGS += -DEN_BUILD_STAMP='"$(BUILD_STAMP)"' -DEN_BUILD_GIT='"$(BUILD_GIT)"'

# The app scan, against a real directory tree. Needs no LVGL and no
# device, and it is what caught the flat-copy fallback listing every folder
# that had no binary in it: access(dir, X_OK) is true for any directory.
.PHONY: scantest
scantest:
	@mkdir -p $(BUILD)
	@$(CC) -O1 -I.. -o $(BUILD)/scantest tests/scantest.c ../apps.c
	@rm -rf /tmp/n31os
	@mkdir -p /tmp/n31os/apps/demo /tmp/n31os/apps/bare /tmp/n31os/apps/empty
	@printf '#!/bin/sh\ntrue\n' > /tmp/n31os/apps/demo/demo
	@printf '#!/bin/sh\ntrue\n' > /tmp/n31os/apps/bare/bare
	@chmod +x /tmp/n31os/apps/demo/demo /tmp/n31os/apps/bare/bare
	@printf '%s\n' '{ "name": "Demo App", "exec": "demo", "tagline": "a test", "glyph": "DA", "color": "#f43f5e", "screen": "console" }' > /tmp/n31os/apps/demo/app.json
	@touch /tmp/n31os/apps/empty/readme
#
# The two builtins, staged in both places, so the test can say which
# copy runs. N31_BUILTIN_DIR stands in for /bin. Radio+ is stale on the
# volume and current in /bin; TinyPod is the other way round.
#
	@mkdir -p /tmp/n31bin /tmp/n31os/apps/radioplus /tmp/n31os/apps/tinypod
	@for f in /tmp/n31os/apps/radioplus/radioplus /tmp/n31os/apps/tinypod/tinypod \
	         /tmp/n31bin/radioplus /tmp/n31bin/tinypod; do \
	   printf '#!/bin/sh\ntrue\n' > $$f; chmod +x $$f; done
#
# The dates say one thing and the stamps say the other, on purpose: on the
# device the volume is FAT read back without a timezone, so its dates are
# hours out and only the stamps mean anything. Radio+ is newer on disk by
# date and older by stamp; TinyPod is the reverse.
#
	@touch -d '2020-01-01 00:00' /tmp/n31bin/radioplus
	@touch -d '2020-01-01 00:00' /tmp/n31os/apps/tinypod/tinypod
	@mkdir -p /tmp/n31builds
	@printf '20200101.0000' > /tmp/n31os/apps/radioplus/BUILD
	@printf '20260902.0511' > /tmp/n31builds/radioplus
	@printf '20260902.1500' > /tmp/n31os/apps/tinypod/BUILD
	@printf '20260902.1459' > /tmp/n31builds/tinypod
	@N31_BUILTIN_DIR=/tmp/n31bin N31_BUILDS_DIR=/tmp/n31builds \
	   $(BUILD)/scantest; rc=$$?; rm -rf /tmp/n31os /tmp/n31bin /tmp/n31builds; exit $$rc

# The scanner thread, plain and then under ThreadSanitizer. A race here
# would show up as a list that is occasionally wrong on a device, which is
# not something you debug by looking - so it gets checked by a tool.
.PHONY: threadtest
threadtest:
	@mkdir -p $(BUILD)
	@$(CC) -O1 -I.. -o $(BUILD)/threadtest tests/threadtest.c ../apps.c ../scanner.c -lpthread
	@$(BUILD)/threadtest
	@echo
	@echo 'under ThreadSanitizer:'
	@$(CC) -O1 -g -fsanitize=thread -I.. -o $(BUILD)/threadtest-tsan tests/threadtest.c ../apps.c ../scanner.c -lpthread
	@$(BUILD)/threadtest-tsan

.PHONY: tests
tests: scantest threadtest

.PHONY: shots clean
shots: $(BUILD)/preview
	@mkdir -p shots
	@./$(BUILD)/preview shots
	@python3 tobmp.py shots && rm -f shots/*.bmp
	@ls shots/


# LVGL, built here rather than borrowed from another app's build directory.
# That directory is gitignored, so depending on it meant this could not be built
# from a fresh clone - and it dangles the moment you check out a branch that
# does not carry that app.
#
# All of src/ is compiled, which is what a liblvgl.a normally is: the parts this
# app does not use are dropped at link time by --gc-sections, and picking a
# subset by hand is how you discover a missing symbol six months later. It is a
# few hundred files, so the first build takes a while - pass -j.
LV_SRCS := $(shell find $(LVGL)/src -name '*.c')
LV_OBJS := $(patsubst $(LVGL)/%.c,$(LV_CACHE)/%.o,$(LV_SRCS))

$(LV_CACHE)/%.o: $(LVGL)/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) $(LV_CFLAGS) -c -o $@ $<

# Coarse, but right: the config decides what LVGL compiles to, so changing it
# has to rebuild all of it.
$(LV_OBJS): | $(LV_CACHE)

$(LVLIB_OWN): $(LV_OBJS)
	@echo "AR $@"
	@$(AR) rcs $@ $^

$(BUILD)/preview: $(SRCS) $(wildcard ../*.h) $(LVLIB)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(LV_CFLAGS) -o $@ $(SRCS) $(LVLIB) -lm -lpthread

clean:
	rm -rf $(BUILD) shots
